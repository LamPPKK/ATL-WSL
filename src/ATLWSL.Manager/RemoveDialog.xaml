<Window x:Class="AtlWsl.Manager.RemoveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove app"
        Width="500"
        Height="285"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Remove this app?" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="PromptText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12"
                Margin="0,17,0,17" VerticalAlignment="Center">
            <TextBlock Text="Retaining data lets ATL-WSL restore this app's isolated data when the same APK is added again. Deleting data is permanent."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Retain data" Margin="0,0,8,0" Click="Retain_Click" />
            <Button Content="Delete all data" Style="{StaticResource DangerButton}" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</Window>
